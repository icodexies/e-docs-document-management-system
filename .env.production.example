# Production build values for `vite build` and the Docker image.
# Copy to `.env.production` and fill in. Public values only (see the comment in
# `.env.example`) — nothing here is secret by design.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

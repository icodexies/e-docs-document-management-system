# Local development values. Copy this file to `.env` and fill it in.
# These values are PUBLIC in the browser build — only the publishable/anon key
# belongs here. NEVER put a service_role / secret key in a VITE_ variable.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

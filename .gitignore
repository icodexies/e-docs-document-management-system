node_modules
dist
dist-ssr

# Local env files — never commit real secrets.
# Copy `.env.example` to `.env` and `.env.production.example` to
# `.env.production` after cloning. The publishable/anon key is public in every
# browser build, but keeping the actual project config out of the repository
# lets everyone connect their own Supabase project.
.env
.env.*
!.env.example
!.env.production.example

# Edge Function secrets (local)
supabase/functions/.env

# Supabase local dev temp files
supabase/.temp
supabase/.branches


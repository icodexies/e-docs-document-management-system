# Function secrets for LOCAL development only (gitignored).
# Production values are set with:  supabase secrets set NAME=value
#
# sign-document uses the Supabase runtime's built-in SUPABASE_URL,
# SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY. No extra secret is required.
#
# Copy this file to `.env` in this folder and fill in — never commit real values.
SITE_URL=http://localhost:5173
# Example provider credential (only if a function sends email):
# SMTP_USER=your-account@example.com
# SMTP_PASSWORD=your-app-password
